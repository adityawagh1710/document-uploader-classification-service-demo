      },
      "Value": {
        "Fn::GetAtt": [
          "WorkspaceConfig__HASH__",
          "Arn",
        ],
      },
    },
    "WorkspaceConfigTableName": {
      "Export": {
        "Name": "ClassificationWorkspaceConfigTableName-dev",
      },
      "Value": {
        "Ref": "WorkspaceConfig__HASH__",
      },
    },
  },
  "Parameters": {
    "BootstrapVersion": {
      "Default": "__BOOTSTRAP_PARAM__",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "ContentHashes__HASH__": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "workspaceId",
            "AttributeType": "S",
          },
          {
            "AttributeName": "contentHash",
            "AttributeType": "S",
          },
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "ContributorInsightsSpecification": {
          "Enabled": true,
        },
        "DeletionProtectionEnabled": false,
        "KeySchema": [
          {
            "AttributeName": "workspaceId",
            "KeyType": "HASH",
          },
          {
            "AttributeName": "contentHash",
            "KeyType": "RANGE",
          },
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false,
        },
        "SSESpecification": {
          "SSEEnabled": true,
        },
        "TableName": "content-hashes-dev",
        "Tags": [
          {
            "Key": "Component",
            "Value": "data",
          },
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true,
        },
      },
      "Type": "AWS::DynamoDB::Table",
      "UpdateReplacePolicy": "Delete",
    },
    "WorkspaceConfig__HASH__": {
      "DeletionPolicy": "Delete",
      "Metadata": "__SCRUBBED_METADATA__",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "workspaceId",
            "AttributeType": "S",
          },
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "ContributorInsightsSpecification": {
          "Enabled": true,
        },
        "DeletionProtectionEnabled": false,
        "KeySchema": [
          {
            "AttributeName": "workspaceId",
            "KeyType": "HASH",
          },
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false,
        },
        "SSESpecification": {
          "SSEEnabled": true,
