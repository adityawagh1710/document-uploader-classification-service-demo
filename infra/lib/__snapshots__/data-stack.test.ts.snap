// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ClassificationDataStack > matches snapshot (dev) 1`] = `
{
  "Outputs": {
    "ContentHashTableArn": {
      "Export": {
        "Name": "ClassificationContentHashTableArn-dev",
      },
      "Value": {
        "Fn::GetAtt": [
          "ContentHashes__HASH__",
          "Arn",
        ],
      },
    },
    "ContentHashTableName": {
      "Export": {
        "Name": "ClassificationContentHashTableName-dev",
      },
