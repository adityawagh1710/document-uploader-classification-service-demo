# syntax=docker/dockerfile:1.7
# ----------------------------------------------------------------------------
# Lambda function image for local docker-compose. Compiles src/ via tsc and
# packages it into the AWS Lambda Node.js 20 runtime image (which ships the
# Lambda Runtime Interface Emulator on :8080). Build context MUST be the
# repository root so package-lock.json is reachable.
# ----------------------------------------------------------------------------

FROM node:20-alpine AS builder
WORKDIR /build
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY src ./src
RUN npx tsc -p tsconfig.json
# Drop dev deps before copying node_modules into the runtime layer.
RUN npm prune --omit=dev

FROM public.ecr.aws/lambda/nodejs:20
# Mirror the runtime layout the deployed function expects: tsc preserves the
# src/ tree under dist/, so the handler entry lives at dist/handler/lambda.js
# and exports `handler`. Lambda CMD below points there as `<path>.<export>`.
COPY --from=builder /build/dist ${LAMBDA_TASK_ROOT}/
COPY --from=builder /build/node_modules ${LAMBDA_TASK_ROOT}/node_modules
# Lambda's ESM loader reads package.json for "type": "module".
COPY --from=builder /build/package.json ${LAMBDA_TASK_ROOT}/
CMD ["handler/lambda.handler"]
