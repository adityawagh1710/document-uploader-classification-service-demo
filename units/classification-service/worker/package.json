{
  "name": "classification-convert-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "SQS poller that drives office-convert /v1/convert for category=convert classifications and writes the result back to the classifications-dev DDB row.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1053.0",
    "@aws-sdk/client-sfn": "3.1053.0",
    "@aws-sdk/client-sqs": "3.1053.0",
    "@aws-sdk/lib-dynamodb": "3.1053.0",
    "undici": "^6.20.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
