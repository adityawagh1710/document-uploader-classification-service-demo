{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDocumentToClassify",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::classification-ui-dev05/*"
    },
    {
      "Sid": "ContentHashDedup",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:537462380503:table/content-hashes-dev"
    },
    {
      "Sid": "WorkspaceConfigRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:537462380503:table/workspace-config-dev"
    },
    {
      "Sid": "DecryptKmsViaS3",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "s3.eu-west-1.amazonaws.com"
          ]
        }
      }
    }
  ]
}
