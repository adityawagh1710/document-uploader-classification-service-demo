{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PollConvertQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:eu-west-1:537462380503:classification-convert-queue-dev"
    },
    {
      "Sid": "UpdateClassificationsRow",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:537462380503:table/classifications-dev"
    },
    {
      "Sid": "DecryptSqsKmsManaged",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "sqs.eu-west-1.amazonaws.com"
        }
      }
    }
  ]
}
