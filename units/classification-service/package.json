{
  "name": "classification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Document Classification Service — first decision point in the document-ingestion pipeline",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:pbt": "vitest run tests/pbt tests/regression",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage tests/unit tests/pbt",
    "bench": "vitest bench --run",
    "build": "tsc -p tsconfig.json",
    "start:classify-http": "node dist/handler/http-server.js",
    "verify-bundle": "bash scripts/verify-bundle.sh",
    "test:infra": "vitest run infra/lib infra/config",
    "cdk": "cdk",
    "cdk:synth": "cdk synth -c env=dev",
    "cdk:diff": "cdk diff -c env=dev"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1053.0",
    "@aws-sdk/client-s3": "3.1053.0",
    "@aws-sdk/client-sfn": "3.1053.0",
    "@aws-sdk/client-sqs": "3.1053.0",
    "@aws-sdk/lib-dynamodb": "3.1053.0",
    "file-type": "21.3.4",
    "pino": "^10.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.142",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "aws-cdk": "2.1124.1",
    "aws-cdk-lib": "2.257.0",
    "cdk-nag": "^2.30.0",
    "constructs": "10.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fast-check": "^3.19.0",
    "testcontainers": "^12.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
