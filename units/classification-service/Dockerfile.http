# syntax=docker/dockerfile:1.7
# ----------------------------------------------------------------------------
# Synchronous classify HTTP endpoint (src/handler/http-server.ts). Same engine
# as Dockerfile.lambda (shared composition), but a long-running Node server.
# The wundergraph-router calls POST /classify.
#
# Build context = REPOSITORY ROOT — the pnpm workspace lockfile lives there.
#   docker build -f units/classification-service/Dockerfile.http -t classification-service-http:dev .
# ----------------------------------------------------------------------------

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /workspace
# Workspace manifests + lockfile first (layer cache); install is content-keyed
# on these, not on the source.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY units/classification-service/package.json units/classification-service/
COPY units/classification-service/worker/package.json units/classification-service/worker/
COPY units/document-uploader-ui/package.json units/document-uploader-ui/
# document-uploader-ui pulls its design system from vendored tarballs (file:
# deps in the shared lockfile); the workspace-wide frozen install needs them
# present even though this image doesn't use the UI.
COPY units/document-uploader-ui/packages units/document-uploader-ui/packages
RUN pnpm install --frozen-lockfile --ignore-scripts
# Build just this member, then produce a self-contained prod deployable
# (flat node_modules via the workspace's node-linker=hoisted).
COPY units/classification-service ./units/classification-service
RUN pnpm --filter classification-service run build
RUN pnpm --filter classification-service deploy --prod /out

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
# tsc preserves the src/ tree under dist/, so the entry is dist/handler/http-server.js.
COPY --from=builder /out/dist ./dist
COPY --from=builder /out/node_modules ./node_modules
COPY --from=builder /out/package.json ./package.json
EXPOSE 8091
USER node
CMD ["node", "dist/handler/http-server.js"]
