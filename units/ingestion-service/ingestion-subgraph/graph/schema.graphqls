# Public GraphQL surface of the wundergraph-router POC — a Federation v2
# subgraph fronted by the WunderGraph Cosmo router.
# Covers what the document-uploader UI needs: workspaces, documents, presigned
# upload, dispatch into the pipeline, and live per-document status.

extend schema @link(url: "https://specs.apollo.dev/federation/v2.3", import: ["@key"])

"Arbitrary string->string map (slipsheet rules). gqlgen binds to map[string]any."
scalar Map

type Workspace {
  id: ID!
  status: String!
  retentionDays: Int
}

type Document {
  id: ID!
  workspaceId: ID!
  filename: String!
  contentType: String!
  status: String!
  pipelineStage: String
}

type CreateDocumentResult {
  document: Document!
  "Presigned PUT URL — client uploads bytes directly to S3 (claim-check)."
  uploadUrl: String!
}

type Stats {
  workspaces: Int!
  documents: Int!
}

"Per-workspace classification policy (the workspace-config the classifier reads)."
type WorkspaceConfig {
  workspaceId: ID!
  policyVersion: String!
  threshold: Float!
  maxZipDepth: Int!
  quarantineMacros: Boolean!
  slipsheetRules: Map!
  hashTtlDays: Int
}

"Synchronous classification result (from the classification service /classify)."
type ClassificationResult {
  documentId: ID!
  workspaceId: ID!
  format: String!
  category: String!
  subCategory: String
  confidenceScore: Float!
  detectionTier: String!
  isForcedSlipsheet: Boolean!
  contentHash: String!
  isDuplicate: Boolean!
  policyVersion: String!
}

input CreateWorkspaceInput {
  retentionDays: Int
}

input CreateDocumentInput {
  workspaceId: ID!
  filename: String!
  contentType: String
}

input WorkspaceConfigInput {
  workspaceId: ID!
  policyVersion: String
  threshold: Float
  maxZipDepth: Int
  quarantineMacros: Boolean
  slipsheetRules: Map
  hashTtlDays: Int
}

type Query {
  workspaces: [Workspace!]!
  documents(workspaceId: ID!): [Document!]!
  document(id: ID!): Document
  stats: Stats!
  "The classification policy for a workspace (null if none saved yet)."
  workspaceConfig(workspaceId: ID!): WorkspaceConfig
  "All saved workspace configs."
  workspaceConfigs: [WorkspaceConfig!]!
}

type Mutation {
  createWorkspace(input: CreateWorkspaceInput!): Workspace!
  createDocument(input: CreateDocumentInput!): CreateDocumentResult!
  "Dispatch a document into the pipeline (claim-check + StageRequest to classify)."
  classifyDocument(documentId: ID!): Document!
  "Synchronously classify an uploaded document via the classification service."
  classify(documentId: ID!): ClassificationResult!
  "Create or update a workspace's classification policy."
  saveWorkspaceConfig(input: WorkspaceConfigInput!): WorkspaceConfig!
}

type Subscription {
  "Live status transitions for a document (graphql-transport-ws)."
  documentStatusChanged(documentId: ID!): Document!
}
